// apps/web/tsconfig.json
{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@acme/db": ["../../packages/db/src/index.ts"],
      "@acme/auth": ["../../packages/auth/index.ts"],
      "@acme/utils": ["../../packages/utils/index.ts"],
      "@acme/order-routing": ["../../packages/order-routing/index.ts"],
      "@repo/ui": ["../../packages/ui/src/index.ts"]
      // "@repo/ui": ["../../packages/ui"],
      // "@acme/utils": ["../../packages/utils"],
      // "@acme/db": ["../../packages/db"],
      // "@acme/order-routing": ["../../packages/order-routing"]
    },
    "types": ["node", "pg", "nodemailer"]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/auth/types/**/*.d.ts"
  ],
  "exclude": ["node_modules"]
}
